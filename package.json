{
  "name": "dsh-work-memory",
  "version": "0.2.0",
  "description": "跨对话的长期工作记忆：按两遍读归纳出两层主题（宽类+细类，带可编辑评述），把对话切成段作为归类单元，召回按「标签→子标签→单元」逐级判断；同时保留 session/seq 原文回放。",
  "keywords": [
    "dsh",
    "plugin",
    "memory",
    "work-memory",
    "topic-induction",
    "segments",
    "recall"
  ],
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metallica360qq-web/dsh-work-memory.git"
  },
  "homepage": "https://github.com/metallica360qq-web/dsh-work-memory#readme",
  "bugs": {
    "url": "https://github.com/metallica360qq-web/dsh-work-memory/issues"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/",
    "cli/",
    "locale/*.json",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "topics.example.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "catalog": {
      "category": "memory",
      "summary": {
        "zh": "跨对话的长期工作记忆：两遍读归纳出两层主题（12 宽类 + 81 细类，带可编辑评述），对话切段后按段归类，召回按标签逐级往下判断；原文按 session/seq 回放。",
        "en": "Cross-conversation work memory: two-pass topic induction (12 broad + fine labels with editable annotations), segment-level classification, hierarchical recall; original spans replayed by session/seq."
      },
      "capabilities": [
        "compaction-survival",
        "seq-recall",
        "artifact-index",
        "topic-induction",
        "segment-classification",
        "hierarchical-recall",
        "provenance-filter",
        "model-tools"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT"
}
